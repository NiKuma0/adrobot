# docker compose reads this file automatically (it sits next to docker-compose.yaml)

# --- App ---
APP_VERSION=latest
# Host interface/port for the web UI; 0.0.0.0 exposes it to the network
APP_BIND=127.0.0.1
APP_PORT=8000

# --- Keitaro ---
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=

# --- Defaults for new campaigns (empty = not set) ---
DEFAULT_GROUP_ID=4970
DEFAULT_TRAFFIC_SOURCE_ID=473
DEFAULT_DOMAIN_ID=4622
GEO_REDIRECT_URL=https://google.com

# --- Postgres (password goes into a URL: keep it URL-safe, e.g. openssl rand -hex 24) ---
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=adrobot
